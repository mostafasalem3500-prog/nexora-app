# قاعدة البيانات — للتطوير المحلي نستخدم SQLite، وللإنتاج استبدلها بـ PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/nexora?schema=public"
DATABASE_URL="file:./dev.db"

# المصادقة (Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# بيانات دخول المدير الأولي (تُستخدم فقط في seed، غيّرها فور أول دخول)
SEED_ADMIN_EMAIL="admin@nexora.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# تخزين الوسائط (اختياري لاحقًا — S3 / Cloud Storage)
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# إشعارات الطلبات (اختياري)
# NOTIFY_EMAIL_WEBHOOK=""
# NOTIFY_WHATSAPP_API_KEY=""
